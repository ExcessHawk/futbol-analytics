# Copy to .env and adjust. .env is gitignored; this file is the documented contract.

# PostgreSQL (docker-compose.yml publishes it on 5450)
DB_HOST=localhost
DB_PORT=5450
DB_NAME=futbol
DB_USER=futbol
DB_PASSWORD=futbol

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Tesseract binary for the bet-slip OCR. On Linux, after `apt install tesseract-ocr`,
# "tesseract" (on PATH) is enough. On Windows it is usually:
#   TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
TESSERACT_CMD=tesseract
# Folder with spa/eng models (python scripts/get_tessdata.py). Default: data/tessdata
# TESSDATA_DIR=

# API-Football (api-sports.io): team/player match stats and xG.
# Free plan = seasons 2022-2024 only; the current season needs a paid plan.
APIFOOTBALL_KEY=
